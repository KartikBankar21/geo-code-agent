FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    geopandas==1.1.4 \
    shapely==2.1.2 \
    pyproj==3.7.2 \
    rasterio==1.5.1 \
    pyogrio

WORKDIR /sandbox

RUN useradd --create-home --shell /usr/sbin/nologin geoagent

RUN mkdir -p /sandbox/input /sandbox/projects \
    && chown -R geoagent:geoagent /sandbox

USER geoagent