# -----------------------------------------------------------------------
# LLM provider selection
# -----------------------------------------------------------------------
# One of: ollama | gemini | groq
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------
# Ollama (local models)
# -----------------------------------------------------------------------
# Optional. If unset, the agent auto-detects a host:
#   - Inside WSL2 (NAT mode): reads the default gateway IP at runtime,
#     so it keeps working across Windows reboots.
#   - Everywhere else (native Linux, WSL2 mirrored networking, Ollama
#     running alongside the agent): falls back to http://localhost:11434.
# Set this explicitly if auto-detection picks the wrong address.
# OLLAMA_HOST=http://172.29.112.1:11434
OLLAMA_MODEL=qwen3.5:4b

# -----------------------------------------------------------------------
# Gemini
# -----------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------
# Groq
# -----------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------
# Directory the API is allowed to read datasets from / write outputs to.
# Defaults to ./data if unset.
# GEO_AGENT_DATA_DIR=./data
